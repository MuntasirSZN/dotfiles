#!/usr/bin/env bash
set -u

lock="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/git-credential-keepassxc.lock"
helper="$(command -v git-credential-keepassxc)"

if [[ -z "$helper" ]]; then
    printf '%s\n' \
        'git-credential-keepassxc was not found in PATH' >&2
    exit 1
fi

while ! mkdir "$lock" 2>/dev/null; do
    sleep 0.05
done

cleanup() {
    rmdir "$lock" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

"$helper" --group "git credentials" "$@"
status=$?

exit "$status"
